rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return signedIn() && profile().role == role; }
    function canManage() { return signedIn() && (profile().role == 'admin' || profile().role == 'finance-manager'); }
    function sameDepartment(departmentId) { return signedIn() && profile().departmentId == departmentId; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canManage());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'viewer';
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow create, update, delete: if canManage();
    }

    match /budgets/{budgetId} {
      allow read: if canManage() || sameDepartment(resource.data.departmentId) || profile().role == 'viewer';
      allow create: if canManage()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['Draft', 'Pending Approval'];
      allow update: if canManage()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status in ['Draft', 'Pending Approval', 'Approved', 'Rejected'];
      allow delete: if canManage() && resource.data.status == 'Draft';
    }

    match /expenses/{expenseId} {
      allow read: if canManage() || sameDepartment(resource.data.departmentId) || resource.data.submittedBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if canManage() || (resource.data.submittedBy == request.auth.uid && resource.data.status == 'Pending');
      allow delete: if canManage();
    }
  }
}
